# apps/candidate-app — משתני סביבה (Vite טוען .env מתיקיית האפליקציה).
# יש להגדיר גם ב-Cloudflare (Settings → Variables) לפני build.

# חובה — כתובת פרויקט Supabase ומפתח anon הציבורי.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# אופציונלי — הצגת לשונית כניסה ב-SMS.
# להפעיל רק אחרי שהוגדר ספק SMS ב-Supabase Auth (ראו docs/DEPLOY.md).
# ללא זה מוצגת כניסה בדוא"ל בלבד, כדי שלא ייכשלו בלי הסבר.
VITE_PHONE_OTP=0
