# האתר הציבורי (Astro, בנייה סטטית).
# אף ערך כאן אינו מגיע לבנדל של הדפדפן פרט למשתני PUBLIC_* — ולכן
# לעולם לא להכניס לכאן מפתח service-role או סיסמה תחת שם PUBLIC_*.
# להעתקה:  cp apps/public-site/.env.example apps/public-site/.env

# בזמן בנייה בלבד: מחרוזת ה-Pooler של Supabase, לצריבת המשרות לתוך האתר.
# נקרא ב-src/data/jobs.ts. אם ריק — האתר נבנה ממשרות הדמה שב-src/data/fixtures.
DATABASE_URL=

# TLS לחיבור המסד בבנייה (ברירת מחדל: verify-full, מאובטח). ה-pooler של Supabase
# מציג תעודה עם CA עצמי, ולכן verify-full נכשל שם ב-"self-signed certificate in
# certificate chain". פותרים באחת משתי דרכים:
#   DATABASE_CA_CERT   — הדביקו את תוכן ה-CA של Supabase (Dashboard → Database →
#                        SSL Configuration → download certificate). אימות מלא מול
#                        ה-CA הנכון — המומלץ.
#   DATABASE_SSL_MODE=require — מוצפן ללא אימות תעודה. פתרון מהיר לבנייה קוראת-בלבד,
#                        פחות מאובטח. הגדירו רק אם אינכם מספקים DATABASE_CA_CERT.
DATABASE_CA_CERT=
DATABASE_SSL_MODE=

# נקודת הקצה של פונקציית ההגשה. נקרא ב-src/components/ApplyForm.astro
# וב-src/pages/apply/[slug].astro. בדיוק הכתובת, בלי גרשיים ובלי שם המשתנה.
PUBLIC_APPLY_ENDPOINT=https://jsxkwosjtjdypwedzxwx.supabase.co/functions/v1/apply

# כתובת הבסיס של האתר, לבניית ה-sitemap והקישורים הקנוניים.
# נקרא ב-astro.config.mjs. ברירת המחדל בקוד: https://hr.ort-tech.co.il
PUBLIC_SITE_URL=https://hr.ort-tech.co.il
