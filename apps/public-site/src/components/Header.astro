---
import { SITE, NAV } from '../data/site';
const path = Astro.url.pathname;
// תפריט אחד בלבד לכל האתר — מגיע מ-data/site.ts (N1).
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <div class="page bar">
    <a href="/" class="brand" aria-label={`${SITE.shortName} — דף הבית`}>
      <picture>
        <source srcset="/ursa-logo-dark.png" media="(prefers-color-scheme: dark)" />
        <img src="/ursa-logo.png" alt={SITE.shortName} class="brand-logo" width="280" height="81" />
      </picture>
    </a>
    <nav aria-label="ניווט ראשי">
      <ul>
        {NAV.map(l => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/jobs/" class="btn btn-primary bar-cta">למשרות הפתוחות</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; inset-block-start: 0; z-index: 20;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-block-end: 1px solid var(--line);
  }
  .bar {
    display: flex; align-items: center; gap: 20px;
    min-block-size: 64px;
  }
  .brand { text-decoration: none; margin-inline-end: auto; display: inline-flex; align-items: center; }
  .brand-logo { block-size: 34px; inline-size: auto; display: block; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-block; padding: 8px 12px; border-radius: var(--radius-sm);
    color: var(--ink-mid); text-decoration: none; font-weight: 500;
  }
  nav a:hover { background: var(--surface-sunk); color: var(--ink); }
  nav a[aria-current="page"] { color: var(--brand); font-weight: 600; }
  .bar-cta { min-height: 40px; padding-block: 8px; }
  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; min-block-size: 56px; gap: 8px 16px; }
    .bar-cta { display: none; }
    nav ul { gap: 2px; }
    nav a { padding: 8px; }
  }
</style>
