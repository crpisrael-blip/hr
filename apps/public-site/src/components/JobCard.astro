---
import { type Job, SCOPE_LABEL, isFresh, formatDate, excerpt } from '../data/jobs';
interface Props { job: Job; }
const { job } = Astro.props;
const scope = job.employment_scope ? SCOPE_LABEL[job.employment_scope] : null;
---
<article class="card"
  data-title={job.title}
  data-location={job.location ?? ''}
  data-scope={job.employment_scope ?? ''}>
  <a class="hit" href={`/jobs/${job.slug}`} aria-label={`למשרה: ${job.title}`}></a>
  <div class="top">
    <h3>{job.title}</h3>
    {isFresh(job) && <span class="tag tag-new">חדש</span>}
  </div>
  <ul class="meta" aria-label="פרטי משרה">
    {job.location && <li>📍 {job.location}</li>}
    {scope && <li>🕒 {scope}</li>}
    {job.company_name && <li>🏢 {job.company_name}</li>}
  </ul>
  <p class="excerpt">{excerpt(job.body)}</p>
  <div class="foot">
    <span class="date">פורסם {formatDate(job.published_at)}</span>
    <span class="go">לפרטים ולהגשה ←</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow-sm);
    transition: border-color .14s ease, box-shadow .14s ease, transform .14s ease;
    display: flex; flex-direction: column; gap: 12px;
  }
  .card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card:focus-within { outline: 2px solid var(--focus); outline-offset: 2px; }
  .hit { position: absolute; inset: 0; z-index: 1; }
  .hit:focus-visible { outline: none; }
  .top { display: flex; align-items: flex-start; gap: 10px; justify-content: space-between; }
  h3 { margin: 0; font-size: 1.12rem; font-weight: 600; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; margin: 0; padding: 0; color: var(--ink-mid); font-size: .88rem; }
  .excerpt { color: var(--ink-mid); font-size: .93rem; }
  .foot { display: flex; align-items: center; justify-content: space-between; margin-block-start: auto; padding-block-start: 4px; }
  .date { color: var(--ink-soft); font-size: .82rem; }
  .go { position: relative; z-index: 2; color: var(--brand); font-weight: 600; font-size: .9rem; }
</style>
