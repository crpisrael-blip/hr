---
import { type Job, SCOPE_LABEL, isFresh, excerpt, formatDate } from '../data/jobs';
interface Props { job: Job; }
const { job } = Astro.props;
const fresh = isFresh(job);
---
<article class="job-card"
  data-title={job.title}
  data-location={job.location ?? ''}
  data-scope={job.employment_scope ?? ''}>
  <a class="card-link" href={`/jobs/${job.slug}`}>
    <div class="row-top">
      <h3>{job.title}</h3>
      {fresh && <span class="tag tag-new">חדש</span>}
    </div>
    <p class="excerpt">{excerpt(job.body)}</p>
    <div class="meta">
      {job.location && <span class="chip">📍 {job.location}</span>}
      {job.employment_scope && <span class="chip">{SCOPE_LABEL[job.employment_scope]}</span>}
      {job.company_name && <span class="chip chip-company">{job.company_name}</span>}
      <span class="date">{formatDate(job.published_at)}</span>
    </div>
  </a>
</article>

<style>
  .job-card {
    background: var(--surface-card); border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
    transition: border-color .14s ease, box-shadow .14s ease, transform .14s ease;
  }
  .job-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .card-link { display: block; padding: 20px; text-decoration: none; color: inherit; block-size: 100%; }
  .row-top { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
  .row-top h3 { color: var(--ink); }
  .excerpt { margin-block: 10px 14px; color: var(--ink-mid); font-size: .92rem; line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: 999px; font-size: .8rem; font-weight: 500;
    background: var(--surface-sunk); color: var(--ink-mid); border: 1px solid var(--line);
  }
  .chip-company { background: var(--brand-soft); color: var(--brand-ink); border-color: transparent; }
  .date { margin-inline-start: auto; color: var(--ink-soft); font-size: .8rem; }
</style>
