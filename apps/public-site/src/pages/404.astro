---
import Base from '../layouts/Base.astro';
---
<Base title="הדף לא נמצא — ort·hr" description="הדף שחיפשתם לא קיים." noindex={true}>
  <div class="page center">
    <p class="code">404</p>
    <h1>הדף לא נמצא</h1>
    <p class="measure">ייתכן שהמשרה נסגרה או שהקישור השתנה.</p>
    <div class="cta">
      <a href="/jobs" class="btn btn-primary">למשרות הפתוחות</a>
      <a href="/" class="btn btn-quiet">לדף הבית</a>
    </div>
  </div>
</Base>
<style>
  .center { padding-block: 72px; text-align: center; display: grid; gap: 12px; justify-items: center; }
  .code { font-size: 3rem; font-weight: 700; color: var(--brand); line-height: 1; }
  .cta { display: flex; gap: 12px; margin-block-start: 12px; }
</style>
