---
import Base from '../layouts/Base.astro';
---
<Base title="הדף לא נמצא — ORT Tech" description="הדף לא נמצא" noindex={true}>
  <div class="page center">
    <p class="big">404</p>
    <h1>הדף לא נמצא</h1>
    <p class="muted">ייתכן שהמשרה נסגרה או שהקישור השתנה.</p>
    <div class="acts">
      <a class="btn btn-primary" href="/jobs">למשרות הפתוחות</a>
      <a class="btn btn-quiet" href="/">לדף הבית</a>
    </div>
  </div>
</Base>
<style>
  .center { text-align: center; padding-block: 80px 100px; }
  .big { font-size: 4rem; font-weight: 700; color: var(--brand); line-height: 1; }
  .muted { color: var(--ink-soft); margin-block: 8px 20px; }
  .acts { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
