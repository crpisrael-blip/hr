---
import Base from '../../layouts/Base.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import { loadJobs, type Job } from '../../data/jobs';

export async function getStaticPaths() {
  const jobs = await loadJobs();
  return jobs.map(job => ({ params: { slug: job.slug }, props: { job } }));
}
interface Props { job: Job; }
const { job } = Astro.props;
---
<Base title={`הגשת מועמדות — ${job.title}`}
      description={`טופס הגשת מועמדות למשרת ${job.title}`}
      noindex={true}>
  <div class="page wrap">
    <nav class="crumbs" aria-label="פירורי לחם">
      <a href="/jobs/">משרות</a> <span aria-hidden="true">›</span>
      <a href={`/jobs/${job.slug}/`}>{job.title}</a> <span aria-hidden="true">›</span>
      <span aria-current="page">הגשה</span>
    </nav>

    <h1>הגשת מועמדות</h1>
    <p class="sub">למשרה: <strong>{job.title}</strong></p>

    <!-- הטופס הוא הקומפוננטה המשותפת: מלכודת בוטים, ולידציית קובץ,
         מנעול הגשה כפולה ושאלות נוספות מבנאי הטפסים (K1). -->
    <ApplyForm slug={job.slug} jobTitle={job.title} />

    <p class="back"><a href={`/jobs/${job.slug}/`}>חזרה לפרטי המשרה</a></p>
  </div>
</Base>

<style>
  .wrap { padding-block: 24px 48px; max-width: 640px; }
  .crumbs { color: var(--ink-soft); font-size: .9rem; margin-block-end: 16px; }
  .crumbs a { color: var(--ink-mid); }
  h1 { margin-block-end: 4px; }
  .sub { color: var(--ink-mid); margin-block-end: 24px; }
  .back { margin-block-start: 20px; font-size: .92rem; }
</style>
