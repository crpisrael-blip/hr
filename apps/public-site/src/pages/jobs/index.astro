---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { loadJobs, locationsOf, fieldsOf, SCOPE_LABEL, FIELD_LABEL } from '../../data/jobs';
import { SITE } from '../../data/site';
const jobs = await loadJobs();
const locations = locationsOf(jobs);
const fields = fieldsOf(jobs);
const scopes = [...new Set(jobs.map(j => j.employment_scope).filter(Boolean))] as string[];
const countLabel = (n: number) => (n === 1 ? 'משרה אחת' : `${n} משרות`);
---
<Base
  title={`משרות פתוחות — ${SITE.shortName}`}
  description="כל המשרות הפתוחות שלנו במקום אחד. חיפוש וסינון לפי מיקום והיקף משרה.">
  <div class="page wrap">
    <header class="head">
      <h1>משרות פתוחות</h1>
      <p class="count" id="count" aria-live="polite">{countLabel(jobs.length)}</p>
    </header>

    <div class="filters" role="search">
      <div class="field grow">
        <label class="visually-hidden" for="q">חיפוש לפי תפקיד, חברה או מילת מפתח</label>
        <input type="search" id="q" placeholder="חיפוש לפי תפקיד, חברה או מילת מפתח…" autocomplete="off" />
      </div>
      <div class="field">
        <label class="visually-hidden" for="field">תחום</label>
        <select id="field">
          <option value="">כל התחומים</option>
          {fields.map(f => <option value={f}>{FIELD_LABEL[f]}</option>)}
        </select>
      </div>
      <div class="field">
        <label class="visually-hidden" for="loc">מיקום</label>
        <select id="loc">
          <option value="">כל המיקומים</option>
          {locations.map(l => <option value={l}>{l}</option>)}
        </select>
      </div>
      <div class="field">
        <label class="visually-hidden" for="scope">היקף</label>
        <select id="scope">
          <option value="">כל ההיקפים</option>
          {scopes.map(s => <option value={s}>{SCOPE_LABEL[s as keyof typeof SCOPE_LABEL]}</option>)}
        </select>
      </div>
    </div>

    {jobs.length === 0 ? (
      <p class="empty">אין כרגע משרות פתוחות. חזרו בקרוב.</p>
    ) : (
      <div class="grid" id="grid">
        {jobs.map(job => <JobCard job={job} headingLevel={2} />)}
      </div>
    )}
    <p class="empty" id="noresults" hidden>לא נמצאו משרות שתואמות את הסינון. נסו להרחיב את החיפוש.</p>
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const field = document.getElementById('field') as HTMLSelectElement;
  const loc = document.getElementById('loc') as HTMLSelectElement;
  const scope = document.getElementById('scope') as HTMLSelectElement;
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
  const count = document.getElementById('count')!;
  const noResults = document.getElementById('noresults')!;

  const label = (n: number) => (n === 1 ? 'משרה אחת' : `${n} משרות`);

  // ערך אופציה קיים בלבד — כדי לא "לנעול" מסנן לערך שאין לו אף משרה.
  function setIfValid(el: HTMLSelectElement | HTMLInputElement, val: string | null) {
    if (!val) return;
    if (el instanceof HTMLSelectElement) {
      if ([...el.options].some(o => o.value === val)) el.value = val;
    } else {
      el.value = val;
    }
  }

  // אתחול מסננים מפרמטרי ה-URL (מגיעים מחיפוש ההירו בעמוד הבית או משבב תחום).
  const params = new URLSearchParams(location.search);
  setIfValid(q, params.get('q'));
  setIfValid(field, params.get('field'));
  setIfValid(loc, params.get('loc'));
  setIfValid(scope, params.get('scope'));

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      // החיפוש מבטיח "מילת מפתח" ולכן סורק גם את התקציר ואת שם החברה,
      // לא רק את שם התפקיד.
      const haystack = [c.dataset.title, c.dataset.body, c.dataset.company, c.dataset.location]
        .join(' ').toLowerCase();
      const okText = !term || haystack.includes(term);
      const okField = !field.value || c.dataset.field === field.value;
      const okLoc = !loc.value || c.dataset.location === loc.value;
      const okScope = !scope.value || c.dataset.scope === scope.value;
      const show = okText && okField && okLoc && okScope;
      c.hidden = !show;
      if (show) shown++;
    }
    count.textContent = label(shown);
    noResults.hidden = shown !== 0;
  }
  [q, field, loc, scope].forEach(el => el.addEventListener('input', apply));
  apply();
</script>

<style>
  .wrap { padding-block: 32px; }
  .head { display: flex; align-items: baseline; gap: 12px; margin-block-end: 20px; }
  .count { color: var(--ink-soft); }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; margin-block-end: 24px; }
  .filters .field.grow { flex: 1 1 260px; }
  .filters .field { flex: 0 0 auto; }
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .empty { color: var(--ink-mid); background: var(--surface-sunk); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; text-align: center; }
</style>
