---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { loadJobs, locationsOf, SCOPE_LABEL } from '../../data/jobs';
const jobs = await loadJobs();
const locations = locationsOf(jobs);
const scopes = [...new Set(jobs.map(j => j.employment_scope).filter(Boolean))] as string[];
---
<Base
  title="משרות פתוחות — ort·hr"
  description="כל המשרות הפתוחות שלנו במקום אחד. חיפוש וסינון לפי מיקום והיקף משרה.">
  <div class="page wrap">
    <header class="head">
      <h1>משרות פתוחות</h1>
      <p class="count"><span id="count">{jobs.length}</span> משרות</p>
    </header>

    <div class="filters" role="search">
      <div class="field grow">
        <label class="visually-hidden" for="q">חיפוש חופשי</label>
        <input type="search" id="q" placeholder="חיפוש לפי תפקיד או מילת מפתח…" autocomplete="off" />
      </div>
      <div class="field">
        <label class="visually-hidden" for="loc">מיקום</label>
        <select id="loc">
          <option value="">כל המיקומים</option>
          {locations.map(l => <option value={l}>{l}</option>)}
        </select>
      </div>
      <div class="field">
        <label class="visually-hidden" for="scope">היקף</label>
        <select id="scope">
          <option value="">כל ההיקפים</option>
          {scopes.map(s => <option value={s}>{SCOPE_LABEL[s as keyof typeof SCOPE_LABEL]}</option>)}
        </select>
      </div>
    </div>

    {jobs.length === 0 ? (
      <p class="empty">אין כרגע משרות פתוחות. חזרו בקרוב.</p>
    ) : (
      <div class="grid" id="grid">
        {jobs.map(job => <JobCard job={job} />)}
      </div>
    )}
    <p class="empty" id="noresults" hidden>לא נמצאו משרות שתואמות את הסינון. נסו להרחיב את החיפוש.</p>
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const loc = document.getElementById('loc') as HTMLSelectElement;
  const scope = document.getElementById('scope') as HTMLSelectElement;
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .card')];
  const count = document.getElementById('count')!;
  const noResults = document.getElementById('noresults')!;

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const okText = !term || (c.dataset.title ?? '').toLowerCase().includes(term);
      const okLoc = !loc.value || c.dataset.location === loc.value;
      const okScope = !scope.value || c.dataset.scope === scope.value;
      const show = okText && okLoc && okScope;
      c.hidden = !show;
      if (show) shown++;
    }
    count.textContent = String(shown);
    noResults.hidden = shown !== 0;
  }
  [q, loc, scope].forEach(el => el.addEventListener('input', apply));
</script>

<style>
  .wrap { padding-block: 32px; }
  .head { display: flex; align-items: baseline; gap: 12px; margin-block-end: 20px; }
  .count { color: var(--ink-soft); }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; margin-block-end: 24px; }
  .filters .field.grow { flex: 1 1 260px; }
  .filters .field { flex: 0 0 auto; }
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .empty { color: var(--ink-mid); background: var(--surface-sunk); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; text-align: center; }
</style>
