---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { loadJobs } from '../data/jobs';
const jobs = await loadJobs();
const latest = jobs.slice(0, 6);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'URSA GROUP',
  url: 'https://hr.ort-tech.co.il',
  description: 'משרדי גיוס והשמה',
};
---
<Base
  title="URSA GROUP — משרות גיוס והשמה"
  description="מאגר משרות פתוחות ממעסיקים מובילים. הגישו מועמדות בקלות, וצוות הגיוס שלנו ילווה אתכם עד ההשמה."
  jsonLd={jsonLd}>
  <section class="hero">
    <div class="page">
      <p class="eyebrow">גיוס והשמה</p>
      <h1>המשרה הבאה שלכם מתחילה כאן</h1>
      <p class="lede measure">אנחנו מחברים בין מועמדים למעסיקים בתהליך אישי ומקצועי. עיינו במשרות הפתוחות, הגישו מועמדות בכמה דקות, וקבלו ליווי צמוד עד החתימה.</p>
      <div class="cta">
        <a href="/jobs" class="btn btn-primary">עיון בכל המשרות</a>
        <a href="#latest" class="btn btn-quiet">המשרות החדשות</a>
      </div>
    </div>
  </section>

  <section id="latest" class="page latest">
    <div class="section-head">
      <h2>משרות שפורסמו לאחרונה</h2>
      <a href="/jobs" class="more">לכל המשרות ←</a>
    </div>
    {latest.length === 0 ? (
      <p class="empty">אין כרגע משרות פתוחות. חזרו בקרוב, אנחנו מעדכנים תדיר.</p>
    ) : (
      <div class="grid">
        {latest.map(job => <JobCard job={job} />)}
      </div>
    )}
  </section>

  <section class="page steps">
    <h2>איך זה עובד</h2>
    <ol class="grid-steps">
      <li><span class="num">1</span><h3>מוצאים משרה</h3><p>מסננים לפי תחום, מיקום והיקף עד שמגיעים למשרה שמתאימה.</p></li>
      <li><span class="num">2</span><h3>מגישים מועמדות</h3><p>טופס קצר וקורות חיים. אין צורך בחשבון בהגשה הראשונה.</p></li>
      <li><span class="num">3</span><h3>מקבלים ליווי</h3><p>מגייס אישי חוזר אליכם, מכין אתכם לראיון ומלווה עד ההשמה.</p></li>
    </ol>
  </section>
</Base>

<style>
  .hero { padding-block: 56px 40px; background:
    radial-gradient(120% 100% at 100% 0, var(--brand-soft) 0, transparent 60%); }
  .eyebrow { color: var(--brand); font-weight: 600; letter-spacing: .04em; font-size: .85rem; }
  .hero h1 { margin-block: 8px 16px; max-width: 16ch; }
  .lede { color: var(--ink-mid); font-size: 1.12rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-block-start: 24px; }
  .latest { margin-block-start: 48px; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-block-end: 20px; }
  .more { font-weight: 600; white-space: nowrap; }
  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .empty { color: var(--ink-mid); background: var(--surface-sunk); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; text-align: center; }
  .steps { margin-block-start: 56px; }
  .steps > h2 { margin-block-end: 20px; }
  .grid-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .grid-steps li { background: var(--surface-card); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
  .num { display: inline-grid; place-items: center; inline-size: 34px; block-size: 34px; border-radius: 50%; background: var(--brand-soft); color: var(--brand-ink); font-weight: 700; margin-block-end: 10px; }
  .grid-steps h3 { margin-block-end: 6px; }
  .grid-steps p { color: var(--ink-mid); font-size: .95rem; }
</style>
