/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://jsxkwosjtjdypwedzxwx.supabase.co https://cloudflareinsights.com; form-action 'self' https://jsxkwosjtjdypwedzxwx.supabase.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# הערות ל-CSP שלמעלה:
# · script-src ללא 'unsafe-inline': vite.build.assetsInlineLimit=0 ב-astro.config
#   מוציא כל סקריפט לקובץ תחת /_astro/, כך שאין בדפים סקריפט מוטבע הניתן להרצה.
#   נבדק מול dist: כל תג <script> עם קוד מוטבע הוא type="application/ld+json" בלבד.
# · בלוק application/ld+json אינו סקריפט בר-הרצה: אלגוריתם "prepare the script
#   element" של HTML יוצא כש-type אינו classic/module, לפני בדיקת ה-CSP המוטבע,
#   ולכן script-src אינו חוסם אותו. אין צורך ב-hash ואין hash-ים לתחזק לכל משרה.
# · style-src משאיר 'unsafe-inline': Astro מטמיע גיליונות סגנון קטנים ב-<head>.
# · font-src 'self': הגופן מתארח אצלנו ואין יותר קריאה ל-fonts.gstatic.com.
# · form-action מתיר גם את דומיין פונקציית ההגשה, כי ה-<form> מפנה אליו
#   כ-action לגיבוי במקרה שה-JS אינו נטען.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
