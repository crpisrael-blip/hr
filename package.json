{
  "name": "hr",
  "private": true,
  "version": "0.1.0",
  "description": "מערכת גיוס והשמה: אתר ציבורי, אזור אישי למועמדים וממשק חברה",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "npm run build --workspace=@hr/team-app",
    "build:team": "npm run build --workspace=@hr/team-app",
    "build:candidate": "npm run build --workspace=@hr/candidate-app",
    "build:public": "npm run build --workspace=@hr/public-site",
    "build:all": "npm run build:public && npm run build:team && npm run build:candidate",
    "check:public": "npm run check --workspace=@hr/public-site",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:team": "wrangler deploy --config apps/team-app/wrangler.toml",
    "deploy:candidate": "wrangler deploy --config apps/candidate-app/wrangler.toml",
    "deploy:public": "wrangler deploy --config apps/public-site/wrangler.toml",
    "db:test": "./scripts/db-test.sh",
    "db:schema": "./scripts/build-schema.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^5.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.18.1",
    "wrangler": "^4.42.0"
  },
  "engines": { "node": ">=22" }
}
